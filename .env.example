# Copy this file to ".env" (docker compose reads it automatically) and change the values.
# Do NOT commit the real .env file - it is already in .gitignore.

# --- Database ---
DB_NAME=evediagnostics
DB_USERNAME=eve
DB_PASSWORD=eve_password
DB_PORT=5432

# --- App ---
APP_PORT=8080
SPRING_PROFILES_ACTIVE=default

# --- JWT ---
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-dev-jwt-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=3600000

# --- Simulated payment gateway ---
# Probability (0.0 - 1.0) that the mock gateway approves a payment.
PAYMENT_SUCCESS_RATE=0.8

# --- Payment webhook ---
# Shared secret used to compute the X-Signature header:
#   hex(HMAC-SHA256(WEBHOOK_SECRET, raw-request-body))
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-dev-webhook-secret