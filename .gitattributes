# Normalise line endings so a Windows clone and a Linux clone produce identical
# files. Important for mvnw (a shell script) and for Flyway migrations.

* text=auto

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.properties text eol=lf
Dockerfile text eol=lf
mvnw     text eol=lf

*.jar    binary
*.png    binary
*.jpg    binary