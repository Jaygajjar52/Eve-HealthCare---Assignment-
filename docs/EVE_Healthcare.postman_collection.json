              "raw": "{\n  \"eventId\": \"evt-provider-9901\",\n  \"paymentId\": \"48c1c468-3c97-4566-bb5d-fcef64ac000f\",\n  \"bookingId\": \"6e250e70-d765-4d0b-99e8-ed09c239c187\",\n  \"status\": \"SUCCESS\",\n  \"timestamp\": \"2026-10-02T11:20:00Z\"\n}"
